{
  "name": "maison-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "docker:start": "docker run --rm -p 4000:4000 youvegotnigel/maison:latest",
    "docker:start:detached": "docker run -d --rm --name maison -p 4000:4000 youvegotnigel/maison:latest",
    "docker:stop": "docker stop maison",
    "test": "playwright test",
    "test:schemas": "playwright test tests/api/schemas.spec.ts --project=api",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:e2e": "playwright test --project=e2e",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "test:full": "concurrently \"npm run docker:start\" \"wait-on http://localhost:4000 && npm test\"",
    "perf:smoke": "k6 run tests/performance/k6-smoke.js",
    "perf:load": "k6 run tests/performance/k6-load.js",
    "perf:stress": "k6 run tests/performance/k6-stress.js",
    "perf:spike": "k6 run tests/performance/k6-spike.js",
    "perf:soak": "k6 run tests/performance/k6-soak.js",
    "perf:quick": "npm run perf:smoke && npm run perf:load",
    "perf:full": "npm run perf:smoke && npm run perf:load && npm run perf:stress && npm run perf:spike && npm run perf:soak"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "playwright-schema-validator": "^1.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
