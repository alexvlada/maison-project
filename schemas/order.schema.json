{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "number" },
    "reference": {
      "type": "string",
      "pattern": "^ORD-[A-Z0-9]+-\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["confirmed"]
    },
    "totalCents": {
      "type": "number",
      "minimum": 0
    },
    "createdAt": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "number", "minimum": 1 },
          "unitCents": { "type": "number", "minimum": 0 }
        },
        "required": ["name", "quantity", "unitCents"],
        "additionalProperties": false
      }
    },
    "shipping": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" }
      },
      "required": ["name", "address", "city", "postalCode"],
      "additionalProperties": false
    }
  },
  "required": ["id", "reference", "status", "totalCents", "createdAt", "items", "shipping"],
  "additionalProperties": false
}