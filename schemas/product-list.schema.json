{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "sellerId": { "type": "number" },
          "sellerName": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "priceCents": { "type": "number" },
          "effectiveCents": { "type": "number" },
          "onSale": { "type": "boolean" },
          "discount": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["percentage", "fixed"] },
                  "value": { "type": "number" }
                },
                "required": ["type", "value"]
              }
            ]
          },
          "stock": { "type": "number" },
          "inStock": { "type": "boolean" },
          "published": { "type": "boolean" },
          "images": { "type": "array", "items": { "type": "string" } },
          "image": { "type": "string" }
        },
        "required": [
          "id", "sellerId", "sellerName", "name", "description", "category",
          "priceCents", "effectiveCents", "onSale", "discount", "stock",
          "inStock", "published", "images", "image"
        ],
        "additionalProperties": false
      }
    },
    "count": { "type": "number" }
  },
  "required": ["products", "count"],
  "additionalProperties": false
}